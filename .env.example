# Copy to .env.local for development. In production, set the same keys in Vercel.

# Database: a local SQLite file in development, Turso in production
# (libsql://<db>-<org>.turso.io + the token from `turso db tokens create <db>`)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# CodiceSocio: sha256 (hex) of the "Token Magico", e.g.
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" '<token>'
MEMBER_PSK_SHA256=
