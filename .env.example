# Copy to .env.local for development. In production, set the same keys in Vercel.

# Database: a local SQLite file in development, Turso in production
# (libsql://<db>-<org>.turso.io + the token from `turso db tokens create <db>`)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# CodiceSocio: sha256 (hex) of the "Token Magico", e.g.
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" '<token>'
MEMBER_PSK_SHA256=

# Better Auth (Tabù login). Secret: `openssl rand -base64 32`. URL: http://localhost:3000 in dev,
# https://mirandola2.it in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud console → APIs & Services → Credentials). Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://mirandola2.it/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImageKit (staff photo uploads from the Tabù). Dev uploads go to a separate folder.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_STAFF_FOLDER=/dev/staff/
